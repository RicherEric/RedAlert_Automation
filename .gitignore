# Local-only: virtualenv, caches, big logs and generated training artefacts.
/.venv/
/logs/
/models/*
!/models/build/
/datasets/
__pycache__/
*.pyc

# Game data extracted from Red Alert 2: Yuri's Revenge is copyrighted; keep it local.
/data/*.ini
/data/*.csf

# Third-party repos and build outputs are fetched/built locally (see tools/build_spawner.bat, tools/ra2bridge/build.bat).
/tools/third_party/
/tools/ra2bridge/out/

# The IEEE paper is licensed to the university and must not be redistributed (either location).
/thesis/A_Data-driven_Approach_to_Solve_a_Production_Constrained_Build-order_Optimization_Problem.pdf

# npm install output for the deck generator
/thesis/node_modules/
/docs/A_Data-driven_Approach_to_Solve_a_Production_Constrained_Build-order_Optimization_Problem.pdf
